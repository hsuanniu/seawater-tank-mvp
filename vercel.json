{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "cloud-public",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "engines/**"
    }
  },
  "crons": [
    { "path": "/api/internal/reservoirs/reconcile", "schedule": "0 16 * * *" }
  ],
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/healthz$", "dest": "/api" },
    { "handle": "filesystem" }
  ]
}
